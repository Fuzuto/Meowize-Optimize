<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
    <LinearGradientBrush x:Key="AppBackground" StartPoint="0,0" EndPoint="0.85,1">
        <GradientStop Color="#3D3028" Offset="0" />
        <GradientStop Color="#292322" Offset="0.42" />
        <GradientStop Color="#1C1D20" Offset="1" />
    </LinearGradientBrush>
    <SolidColorBrush x:Key="SidebarBackground" Color="#292321" />
    <SolidColorBrush x:Key="Surface" Color="#302825" />
    <SolidColorBrush x:Key="SurfaceRaised" Color="#4A3E38" />
    <SolidColorBrush x:Key="GlassInset" Color="#82574B44" />
    <LinearGradientBrush x:Key="GlassSurface" StartPoint="0,0" EndPoint="0.9,1">
        <GradientStop Color="#D0433832" Offset="0" />
        <GradientStop Color="#E6302928" Offset="0.65" />
        <GradientStop Color="#EA292526" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="GlassHighlight" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#B7604C39" Offset="0" />
        <GradientStop Color="#E23D3330" Offset="0.44" />
        <GradientStop Color="#F02F2928" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="GlassRim" StartPoint="0,0" EndPoint="0.6,1">
        <GradientStop Color="#68FFE6CF" Offset="0" />
        <GradientStop Color="#2EF7DCCB" Offset="0.48" />
        <GradientStop Color="#26675A55" Offset="1" />
    </LinearGradientBrush>
    <SolidColorBrush x:Key="Stroke" Color="#62514A" />
    <SolidColorBrush x:Key="TextMain" Color="#FFF5E9" />
    <SolidColorBrush x:Key="TextMuted" Color="#D9C8BB" />
    <SolidColorBrush x:Key="Accent" Color="#F1D1AF" />
    <SolidColorBrush x:Key="AccentSurface" Color="#584338" />
    <SolidColorBrush x:Key="AccentText" Color="#31231C" />
    <SolidColorBrush x:Key="AccentButtonBackground" Color="#F1D1AF" />
    <SolidColorBrush x:Key="AccentButtonBackgroundPointerOver" Color="#FAE1C5" />
    <SolidColorBrush x:Key="AccentButtonBackgroundPressed" Color="#E7BC96" />
    <SolidColorBrush x:Key="AccentButtonForeground" Color="#31231C" />
    <SolidColorBrush x:Key="AccentButtonForegroundPointerOver" Color="#31231C" />
    <SolidColorBrush x:Key="Warning" Color="#F3CC73" />
    <SolidColorBrush x:Key="Error" Color="#FF9B95" />
    <SolidColorBrush x:Key="RiskSafe" Color="#9EE0BB" />
    <SolidColorBrush x:Key="RiskSafeFill" Color="#C1344C40" />
    <SolidColorBrush x:Key="RiskCaution" Color="#F3CC73" />
    <SolidColorBrush x:Key="RiskCautionFill" Color="#D04D3E28" />
    <SolidColorBrush x:Key="RiskWarning" Color="#FF9B95" />
    <SolidColorBrush x:Key="RiskWarningFill" Color="#C4533333" />

    <Style x:Key="UiFocusStyle" TargetType="Control">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate>
                    <Border BorderBrush="{DynamicResource Accent}" BorderThickness="1.5"
                            CornerRadius="12" Margin="-2" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="CardSurface" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource GlassSurface}" />
        <Setter Property="BorderBrush" Value="{DynamicResource GlassRim}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="16" />
    </Style>

    <Style x:Key="BodyText" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource TextMain}" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="FontSize" Value="14" />
    </Style>

    <Style x:Key="MutedText" TargetType="TextBlock" BasedOn="{StaticResource BodyText}">
        <Setter Property="Foreground" Value="{DynamicResource TextMuted}" />
        <Setter Property="FontSize" Value="12" />
    </Style>

    <Style x:Key="SectionLabel" TargetType="TextBlock" BasedOn="{StaticResource BodyText}">
        <Setter Property="FontSize" Value="15" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <Style x:Key="NavigationItem" TargetType="ListBoxItem">
        <Setter Property="Padding" Value="10,0" />
        <Setter Property="Height" Value="44" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Foreground" Value="{DynamicResource TextMuted}" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource UiFocusStyle}" />
        <Setter Property="Margin" Value="0,0,0,3" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Border x:Name="ItemSurface" Background="Transparent" CornerRadius="12">
                        <Grid>
                            <Border x:Name="ActiveRail" Width="3" Height="18" HorizontalAlignment="Left"
                                    VerticalAlignment="Center" Background="{DynamicResource Accent}" CornerRadius="1.5"
                                    Visibility="Collapsed" />
                            <ContentPresenter Margin="{TemplateBinding Padding}" VerticalAlignment="Center" />
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="ItemSurface" Property="Background" Value="{DynamicResource SurfaceRaised}" />
                            <Setter Property="Foreground" Value="{DynamicResource TextMain}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="ItemSurface" Property="Background" Value="{DynamicResource AccentSurface}" />
                            <Setter TargetName="ActiveRail" Property="Visibility" Value="Visible" />
                            <Setter Property="Foreground" Value="{DynamicResource Accent}" />
                            <Setter Property="FontWeight" Value="SemiBold" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="ActionButton" TargetType="ui:Button" BasedOn="{StaticResource {x:Type ui:Button}}">
        <Setter Property="MinHeight" Value="36" />
        <Setter Property="Padding" Value="12,6" />
        <Setter Property="CornerRadius" Value="17" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource UiFocusStyle}" />
    </Style>
</ResourceDictionary>
