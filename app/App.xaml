<Application x:Class="AioOptimize.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             ShutdownMode="OnExplicitShutdown">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ui:ThemesDictionary Theme="Dark" />
                <ui:ControlsDictionary />
                <ResourceDictionary Source="Theme.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <DataTemplate x:Key="RegionRow">
                <StackPanel Orientation="Horizontal" Margin="3,4">
                    <Image Source="{Binding Flag}" Width="27" Height="19" Stretch="Uniform" />
                    <TextBlock Text="{Binding DisplayName}" VerticalAlignment="Center" Margin="11,0,0,0" />
                </StackPanel>
            </DataTemplate>
        </ResourceDictionary>
    </Application.Resources>
</Application>
